{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=jobparser;Username=jobparser;Password=jobparser"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Features": {
    "CvEnabled": true,
    "CvGenerationEnabled": true,
    "DemoEnabled": true
  },
  "Demo": {
    "SessionLifetimeHours": 6,
    "MaxCompilationJobsPerWindow": 2,
    "CompilationWindowMinutes": 60
  },
  "Authentication": {
    "Google": {
      "Enabled": false,
      "FrontendUrl": "http://localhost:5173/",
      "AllowedUsers": []
    }
  },
  "CvWorkflow": {
    "MaxGenerationJobsPerWorkspace": 10,
    "MaxCompilationJobsPerWorkspace": 10,
    "MaxUserInstructionCharacters": 5000,
    "MaxCustomJobDescriptionCharacters": 20000,
    "RealUserGenerator": "local-codex"
  },
  "CodexCli": {
    "ExecutablePath": "codex",
    "TimeoutSeconds": 300,
    "MaxOutputCharacters": 250000
  },
  "Compilation": {
    "Executable": "tectonic",
    "TimeoutSeconds": 25,
    "MaxTexBytes": 200000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
